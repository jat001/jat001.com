---
import { profile } from '../data/profile';
---

<footer>
  Made with <span class="heart">❤</span>{' '}
  <a href={profile.repo} target="_blank" rel="noopener noreferrer">Astro</a>
</footer>

<style>
  footer {
    padding: 0 var(--gut) clamp(16px, 3.4vh, 28px);
    text-align: center;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dimmer);
    white-space: nowrap;
  }

  .heart {
    /* ask for the text glyph rather than a colour emoji, so it takes --mg */
    font-variant-emoji: text;
    color: var(--mg);
  }

  a {
    color: var(--dim);
    border-bottom: 1px solid transparent;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  a:hover,
  a:focus-visible {
    color: var(--cy);
    border-bottom-color: var(--cy);
  }
</style>
