---
import { profile } from '../data/profile';
---

<div class="intro">
  <h1 class="name">{profile.name}</h1>
  <p class="tagline">{profile.tagline}</p>

  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'noopener noreferrer me' : 'me'}
            {...link.href.startsWith('http') ? { target: '_blank' } : {}}
          >
            <span class="key">{link.label}</span>
            <span class="value">{link.display}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Below 960px the sphere is gone and nothing else claims the width, so
     without a ceiling the contact cells reach 431px — nearly twice what they
     are on a desktop. The two-column track tops out at 468px, so this only
     ever bites once the columns have collapsed. */
  .intro {
    width: min(100%, 30rem);
    margin-inline: auto;
    /* the basis for the cqw type below — not a query, nothing reads it as one */
    container-type: inline-size;
  }

  /* The contact panel is solid and bordered, the sphere beside it mostly air;
     on a shared midline this column reads as the heavier one. Below 960px
     there is no sphere to balance against, and under 700px no slack to lift
     into without clipping the name. */
  @media (min-width: 960px) and (min-height: 700px) {
    .intro {
      translate: 0 -30px;
    }
  }

  .name {
    /* Sized from the column, not the viewport. The column caps at 30rem, so
       past that point vw no longer stands in for it and the name kept
       shrinking against a column that had stopped moving. */
    font-size: min(47cqw, 220px);
    font-weight: 600;
    line-height: 0.84;
    text-align: center;
    /* glyphs overflow the 0.84 line box; pad it back so the block centres */
    padding-top: 0.22em;
    /* J is right-weighted, so optical centre sits left of geometric */
    translate: -0.03em 0;
    letter-spacing: -0.05em;
    background: var(--ramp);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    /* from the column too, so it holds its ratio to the name */
    font-size: clamp(18px, 6cqw, 28px);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: -0.015em;
    color: var(--dim);
    text-align: center;
    margin-top: 30px;
  }

  .links {
    display: grid;
    /* Four contacts: auto-fit fits three across this column and drops the
       fourth into a row of its own. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 62px;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .links a {
    display: flex;
    flex-direction: column;
    gap: 7px;
    height: 100%;
    padding: 22px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-raised);
    transition: color 0.3s var(--ease);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--cy);
  }
  .key {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dimmer);
  }
  .value {
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  /* A phone, not a squeeze: two up needs 272px — "chat@jat.email" measures
     103.6px, so a cell needs 136px — and the narrowest this column ever gets
     beside the sphere is 374px. Querying the column instead of the viewport
     cannot separate the two, because a phone's column (288-432px) and the
     column beside the sphere (374-468px) overlap. */
  @media (max-width: 480px) {
    .links {
      grid-template-columns: minmax(0, 1fr);
    }
    .links a {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 16px;
    }
  }
</style>
