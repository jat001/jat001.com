---
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Sphere from '../components/Sphere.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';
---

<Base>
  <ThemeToggle />
  <main>
    <Hero />
    <Sphere />
  </main>
  <Footer />
</Base>

<style>
  main {
    flex: 1;
    /* Deliberately narrow: the two columns should read as one composition
       rather than drifting to opposite edges of a wide screen. */
    width: min(100%, 75rem);
    margin-inline: auto;
    padding: clamp(32px, 6vh, 64px) var(--gut);
    display: grid;
    /* 29 : 35 is 464px : 560px, the split on a full-width shell, kept at every
       width so the sphere stays the wider column down to the breakpoint. In
       fr rather than `auto`, which sizes the sphere's track from a stage that
       sizes itself from the track, and collapses it to zero. */
    grid-template-columns: minmax(0, 29fr) minmax(0, 35fr);
    align-items: center;
    /* The row is only as tall as the taller column. Stretched to all of main
       instead, it would hand the sphere stage the whole screen and its 74svh
       cap would never apply. */
    align-content: center;
    /* ceiling set where 4vw lands at a 75rem shell, so it stops with the shell */
    gap: clamp(20px, 4vw, 48px);
  }

  @media (max-width: 959px) {
    main {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(28px, 6vh, 48px);
    }
  }
</style>
