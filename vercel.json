{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "astro",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev --port $PORT",
  "outputDirectory": "./dist",

  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)worker' ':(exclude)wrangler.jsonc' ':(exclude).github' ':(exclude).vscode' ':(exclude).gitignore' ':(exclude,glob)*.md'; then exit 0; else exit 1; fi",

  "cleanUrls": true,
  "trailingSlash": false,

  "routes": [
    {
      "src": "^/404$",
      "methods": ["GET", "HEAD"],
      "status": 404
    },
    {
      "src": "^/$",
      "methods": ["GET", "HEAD"],
      "dest": "/index.md",
      "headers": {
        "Vary": "Accept"
      },
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "^(?:.*,)?\\s*text/markdown\\s*(?:[;,].*)?$"
        }
      ]
    },
    {
      "src": "^/$",
      "methods": ["GET", "HEAD"],
      "headers": {
        "Vary": "Accept"
      }
    }
  ]
}
