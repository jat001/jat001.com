{
  "name": "jat001.com",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm run build:languages && astro dev",
    "check": "pnpm run build:languages && astro check",
    "build": "pnpm run check && astro build",
    "preview": "pnpm run build && astro preview",
    "build:languages": "node scripts/build-languages.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "devicon": "^2.17.0",
    "negotiator": "^1.1.0",
    "simple-icons": "^16.32.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
