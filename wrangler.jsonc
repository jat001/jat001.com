{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "site",
  "compatibility_date": "2026-09-20",

  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/404", "/404.html"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },

  "cache": {
    "enabled": true,
  },

  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
